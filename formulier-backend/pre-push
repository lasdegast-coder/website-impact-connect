#!/usr/bin/env bash
#
# Wordt door git aangeroepen bij 'git push'. Doet twee dingen.
#
# 1. Kijkt of de JavaScript-bestanden van de site nog te lezen zijn. Eén
#    vergeten komma in data.js en een hele lijst verdwijnt van de site, en
#    omdat een push meteen live staat merkt niemand het tot een bezoeker het
#    ziet. Dan liever dat de push stopt.
#
# 2. Alleen als er iets aan de backend is veranderd gaat die mee naar Google.
# Verander je alleen de website, dan gebeurt hier niets en duurt pushen net
# zo lang als altijd.
#
# Gaat het uitrollen mis, dan stopt de push. Dat is met opzet: een site die
# live gaat terwijl de backend nog de oude versie draait, is precies de
# situatie waarin de alumnilijst leeg blijft en niemand weet waarom.
#
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
BACKEND="formulier-backend"

# ── 1. zijn de scripts van de site nog heel? ──────────────────────────
if command -v node >/dev/null 2>&1; then
  KAPOT=0
  for bestand in "$REPO"/*.js; do
    if ! FOUT="$(node --check "$bestand" 2>&1)"; then
      echo >&2
      echo "✗ $(basename "$bestand") bevat een fout, dus de push is gestopt." >&2
      echo "$FOUT" | sed -n '1,3p' | sed 's/^/    /' >&2
      KAPOT=1
    fi
  done
  if [ "$KAPOT" -eq 1 ]; then
    echo >&2
    echo "  Op de regel hierboven, of vlak ervoor, mist meestal een komma," >&2
    echo "  een aanhalingsteken of een haakje. Herstel het en push opnieuw." >&2
    exit 1
  fi
else
  echo "▸ Node staat niet op deze computer; de scripts zijn niet gecontroleerd."
fi

# ── 2. de backend ──────────────────────────────────────────────────────

# Wat gaat er mee in deze push? git geeft de commits door op stdin.
VERANDERD=0
while read -r _lokale_ref lokale_sha _externe_ref externe_sha; do
  [ "$lokale_sha" = "0000000000000000000000000000000000000000" ] && continue   # branch wordt verwijderd
  if [ "$externe_sha" = "0000000000000000000000000000000000000000" ]; then
    BEREIK="$lokale_sha"                                    # nieuwe branch: alles
  else
    BEREIK="$externe_sha..$lokale_sha"
  fi
  if git diff --name-only "$BEREIK" -- "$BACKEND" | grep -q '\.gs$'; then
    VERANDERD=1
  fi
done

[ "$VERANDERD" -eq 1 ] || exit 0

echo
echo "▸ Er is Apps Script-code gewijzigd. Die gaat eerst naar Google."
if ! "$REPO/$BACKEND/uitrollen.sh"; then
  echo
  echo "✗ Het uitrollen naar Google is mislukt, dus de push is gestopt." >&2
  echo "  Los dat eerst op, of push met --no-verify als je alleen de site wilt bijwerken." >&2
  exit 1
fi
echo
